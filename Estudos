<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<title>Minha Rotina de Estudos</title>

<style>
  body {
    font-family: Arial;
    background: linear-gradient(to right, #4facfe, #00f2fe);
    text-align: center;
  }

  header {
    background: #222;
    color: white;
    padding: 20px;
  }

  .tabs button {
    padding: 10px;
    margin: 5px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    background: #fff;
  }

  .tabs button:hover {
    background: #ddd;
  }

  .conteudo {
    display: none;
    background: white;
    margin: 20px auto;
    padding: 20px;
    width: 85%;
    border-radius: 15px;
    text-align: left;
  }

  .ativo {
    display: block;
  }

  h3 {
    color: #333;
  }

  li {
    background: #f1f1f1;
    margin: 8px 0;
    padding: 10px;
    border-radius: 8px;
  }

  li[contenteditable] {
    outline: none;
  }
</style>

<script>
function abrirDia(dia) {
  let conteudos = document.querySelectorAll(".conteudo");
  conteudos.forEach(c => c.classList.remove("ativo"));

  document.getElementById(dia).classList.add("ativo");
}
</script>

</head>

<body>

<header>
  <h1>📚 Minha Rotina de Estudos</h1>
</header>

<div class="tabs">
  <button onclick="abrirDia('seg')">Segunda</button>
  <button onclick="abrirDia('ter')">Terça</button>
  <button onclick="abrirDia('qua')">Quarta</button>
  <button onclick="abrirDia('qui')">Quinta</button>
  <button onclick="abrirDia('sex')">Sexta</button>
</div>

<!-- SEGUNDA -->
<div id="seg" class="conteudo ativo">
  <h2>Segunda-feira</h2>

  <h3>Português</h3>
  <ul>
    <li contenteditable="true">Enunciação: enunciador, enunciatário e enunciado</li>
    <li contenteditable="true">Processos de inferência: implícitos e pressupostos</li>
    <li contenteditable="true">Teoria da comunicação: elementos e funções da linguagem</li>
    <li contenteditable="true">Variação linguística: diastrática, diafásica, diacrônica, diatópica</li>
    <li contenteditable="true">Morfologia: substantivo (efeitos semânticos)</li>
  </ul>

</div>

<!-- TERÇA -->
<div id="ter" class="conteudo">
  <h2>Terça-feira</h2>

  <h3>Geografia</h3>
  <ul>
    <li contenteditable="true">Cartografia</li>
    <li contenteditable="true">Curvas de nível</li>
  </ul>

</div>

<!-- QUARTA -->
<div id="qua" class="conteudo">
  <h2>Quarta-feira</h2>

  <h3>Geologia / Geomorfologia</h3>
  <ul>
    <li contenteditable="true">Tempo Geológico: coluna geológica e eventos</li>
    <li contenteditable="true">Rochas: magmáticas, sedimentares e metamórficas</li>
    <li contenteditable="true">Ciclo das rochas e processos de formação</li>
  </ul>

</div>

<!-- QUINTA -->
<div id="qui" class="conteudo">
  <h2>Quinta-feira</h2>

  <h3>Física</h3>
  <ul>
    <li contenteditable="true">Adicione aqui o conteúdo que vai estudar</li>
  </ul>

</div>

<!-- SEXTA -->
<div id="sex" class="conteudo">
  <h2>Sexta-feira</h2>

  <h3>Literatura</h3>
  <ul>
    <li contenteditable="true">Livro: Campo Geral</li>
  </ul>

</div>

</body>
</html>
